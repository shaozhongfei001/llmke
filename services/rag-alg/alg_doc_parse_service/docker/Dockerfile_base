FROM python:3.11.9

# 注意要将ocr_models、nltk_data和deepdoc/huqie.txt.trie加进来 这三个文件并不在gitlab上
COPY . /workdir
WORKDIR /workdir

RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y ffmpeg libsm6 libxext6 libgl1 nano iputils-ping vim && \
    rm -rf /var/lib/apt/lists/*


# 注意需要根据系统及cpu架构来切换不同的jdk https://jdk.java.net/22/
RUN apt-get update && \
    apt-get install ffmpeg libsm6 libxext6 libgl1 nano iputils-ping vim -y && \
    python3 -m pip install --upgrade pip -i https://pypi.mirrors.ustc.edu.cn/simple && \
    python3 -m pip install --no-cache-dir -r requirements.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
        --timeout 120 --retries 5 && \
    tar -xvf openjdk-22.0.2_linux-x64_bin.tar -C /root && \
    rm -f openjdk-22.0.2_linux-x64_bin.tar && \
    mv nltk_data /root/ && \
    mv ocr_models /root/ && \
    mv tika-server.jar /root/ && \
    mv tika-server.jar.md5 /root/ && \
    mv tiktoken_cache /root/ && \
    mv deepdoc/huqie.txt /root/ && \
    mv deepdoc/huqie.txt.trie /root/ && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo 'Asia/Shanghai' > /etc/timezone


