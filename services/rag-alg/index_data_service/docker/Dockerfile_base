# ===== Base 镜像 =====
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    NACOS_SERVER_ADDRESS="http://10.15.12.12:8848" \
    NAMESPACE="rag-ai-dev" \
    DATA_ID="index_data_config_py" \
    GROUP="DEFAULT_GROUP" \
    TIKTOKEN_CACHE_DIR="/root/tiktoken_cache"

WORKDIR /app

# 使用阿里云源 + 安装 Python、构建工具 + 时区 + pip 基础工具 + 清理缓存
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3.11 \
        python3.11-dev \
        python3.11-distutils \
        python3-pip \
        curl \
        wget \
        vim \
        tzdata && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 复制依赖文件和 tiktoken 缓存
COPY requirements.txt /app/
COPY tiktoken_cache /root/tiktoken_cache

RUN python3 -m pip install --upgrade pip \
    -i https://pypi.mirrors.ustc.edu.cn/simple && \
    python3 -m pip install --no-cache-dir -r requirements.txt \
    -i https://pypi.mirrors.ustc.edu.cn/simple \
    --timeout 120 --retries 5

# 暴露通用端口
EXPOSE 19525 19526 19527 19529
