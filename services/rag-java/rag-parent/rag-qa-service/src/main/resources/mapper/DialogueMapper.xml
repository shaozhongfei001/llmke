<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gientech.ragqaservice.domain.mapper.DialogueMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gientech.ragqaservice.domain.model.DialogueDO">
        <id column="id" property="id" />
        <result column="label" property="label" />
        <result column="session_id" property="sessionId" />
        <result column="status" property="status" />
        <result column="gmt_create" property="gmtCreate" />
        <result column="gmt_modified" property="gmtModified" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
        <result column="config" property="config" />
        <result column="config_id" property="configId" />
        <result column="config_history" property="configHistory" />
        <result column="sys_type" property="sysType" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, label, session_id, status, gmt_create, gmt_modified, create_by, update_by, config, sys_type
    </sql>

    <select id="getIdsBySessionIdAndQueryId" resultType="com.gientech.ragqaservice.domain.model.DbIdDO">
        select a.id answerId from dialogue d LEFT JOIN question q on d.id=q.dialogue_id
             LEFT JOIN answer a on q.id=a.question_id
        <where>
            d.session_id = #{sessionId} and q.front_uuid=#{questionId}
        </where>
    </select>

</mapper>
