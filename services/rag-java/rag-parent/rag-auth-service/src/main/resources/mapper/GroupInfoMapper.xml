<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gientech.ragauthservice.domain.mapper.GroupInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gientech.ragauthservice.domain.model.GroupInfoDO">
        <id column="id" property="id" />
        <result column="pid" property="pid" />
        <result column="name" property="name" />
        <result column="description" property="description" />
        <result column="gmt_create" property="gmtCreate" />
        <result column="gmt_modified" property="gmtModified" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, pid, name, description, gmt_create, gmt_modified, create_by, update_by
    </sql>
    <select id="findByIds" resultType="com.gientech.ragauthservice.domain.model.GroupInfoDO">
        select <include refid="Base_Column_List"></include>
        from group_info
        where
         is_del=1 and id in
        <foreach collection="ids" item="id" separator="," close=")" open="(">
           #{id}
        </foreach>
    </select>

</mapper>
