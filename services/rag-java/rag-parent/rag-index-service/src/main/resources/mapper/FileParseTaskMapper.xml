<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gientech.ragindexservice.domain.mapper.FileParseTaskMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gientech.ragindexservice.domain.model.FileParseTaskDO">
        <id column="id" property="id"/>
        <id column="kb_id" property="kbId"/>
        <id column="kb_name" property="kbName"/>
        <id column="file_id" property="fileId"/>
        <id column="file_name" property="fileName"/>
        <id column="task_info" property="taskInfo"/>
        <id column="status" property="status"/>
        <id column="start_time" property="startTime"/>
        <id column="end_time" property="endTime"/>
        <id column="retry_limit" property="retryLimit"/>
        <id column="retry_times" property="retryTimes"/>
        <id column="error_msg" property="errorMsg"/>
        <id column="create_by" property="createBy"/>
        <id column="gmt_create" property="gmtCreate"/>
        <id column="modify_by" property="modifyBy"/>
        <id column="gmt_modified" property="gmtModified"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        ,kb_id,kb_name,file_id,file_name,task_info,status,start_time,end_time,retry_limit,retry_times,error_msg,create_by,gmt_create,modify_by,gmt_modified
    </sql>

    <insert id="saveBatch" useGeneratedKeys="true" keyProperty="id">
        insert into file_parse_task(kb_id, kb_name,file_id, file_name, task_info, status,start_time,
        end_time,retry_limit,retry_times,error_msg,create_by,gmt_create,modify_by,gmt_modified)
        values
        <foreach collection="list" item="it" separator=",">
            (#{it.kbId}, #{it.kbName},#{it.fileId}, #{it.fileName}, #{it.taskInfo}, #{it.status},
            #{it.startTime},#{it.endTime},#{it.retryLimit},#{it.retryTimes},#{it.errorMsg},#{it.createBy},
            #{it.gmtCreate},#{it.modifyBy},#{it.gmtModified})
        </foreach>
    </insert>
    <update id="updateStatusByIds">
        UPDATE file_parse_task
        SET status = #{status},gmt_modified = NOW()
        where id in <foreach collection="taskIds" separator="," open="(" close=")" item="id">#{id}</foreach>
    </update>

    <!-- R14-C-FIX-32：派发前的**抢占（CAS）**。
         原实现是"先 select 出可派发任务，再同步调解析，解析成功后才把 status 置 DEAL_ING"，
         也就是说**整个解析窗口内任务状态仍是 PENDING(1)/RETRY_ING(3)**。
         任何第二个执行者（多实例、POST /execTask 手工触发、Redisson 锁 5 秒租约过期后下一轮）
         都会把同一 task_id 再取一次 → 同一文件被两个 worker 同时解析（重复写、互相覆盖）。
         FIX-30 让 RETRY_ING 重新可派发后，这个窗口从 PENDING 扩大到了 RETRY_ING。
         这里用带 status 条件的 UPDATE 做原子抢占：只有真正把状态从 1/3 改成 2 的那个执行者
         才能继续派发；返回 0 表示已被别人抢走，必须跳过。 -->
    <update id="claimTask">
        <!-- `COALESCE(start_time, NOW())` 不是防御性编程，是**语义修正**（R14-C-P2-01②）：
             start_time 的语义是"这个任务什么时候开始被处理"，不是"最近一次重试是什么时候"。
             原实现每轮派发都刷新它，导致超时判定永远从新的起点算 -> 永久失败的文件永远算不出超时。
             若将来需要"最近一次重试时间"，应新增 last_retry_at 字段，不要复用 start_time。 -->
        UPDATE file_parse_task
        SET status = #{toStatus},
            start_time = COALESCE(start_time, NOW()),
            gmt_modified = NOW()
        where id = #{id}
          and status in <foreach collection="fromStatus" item="s" separator="," open="(" close=")">#{s}</foreach>
    </update>
    <!-- R14-LIVE-11：见 FileParseTaskMapper.cancelOpenTasksByKb 的注释 -->
    <update id="cancelOpenTasksByKb">
        UPDATE file_parse_task
        SET status = 5,
            end_time = NOW(),
            error_msg = #{msg},
            gmt_modified = NOW()
        WHERE kb_id = #{kbId}
          AND status IN (1, 2, 3)
    </update>

    <select id="getTaskList" resultType="com.gientech.ragindexservice.domain.model.FileParseTaskDO">
        select
        <include refid="Base_Column_List"/>
        from file_parse_task
        where
        status in
        <foreach collection="taskStatus" item="status" separator="," open="(" close=")">
            #{status}
        </foreach>
        and retry_limit > retry_times
        <!-- R13-FIX-QUEUE-01：只派发"文件仍然有效"的任务。
             原 SQL 不判断文件是否已删除，删除后的历史任务会一直留在队列头部（status 仍为 1/3），
             按 id asc 每次都被优先取到、解析必然失败并永久占用并发槽，导致新上传的文件永远排在后面（表现为恒为 99）。 -->
        and file_id in (select id from knowledge_base_list where status &lt;&gt; 0)
        order by id asc
        limit #{limit}
    </select>

    <update id="deleteByFileIds" >
        UPDATE file_parse_task
        SET status = 0
        where file_id in <foreach collection="fileIds" separator="," open="(" close=")" item="fileId">#{fileId}</foreach>
    </update>

    <update id="deleteByKbIds" >
        UPDATE file_parse_task
        SET status = 0
        where kb_id in <foreach collection="kbIds" separator="," open="(" close=")" item="kbId">#{kbId}</foreach>
    </update>

    <select id="getSequenceByFileId" resultType="java.lang.Long">
        SELECT
          count(1)
        FROM
        file_parse_task
        WHERE
        id <![CDATA[<]]> (SELECT id FROM file_parse_task WHERE file_id = #{fileId} and status in(1,2,3) limit 1)
        and status in(1);
    </select>

</mapper>
