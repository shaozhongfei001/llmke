<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gientech.ragindexservice.domain.mapper.ReEmbeddingRetryTaskMapper">

    <select id="findExistTaskByFileId" resultType="int">
        SELECT count(1)
        FROM re_embedding_retry_task
        WHERE task_id = #{taskId}
          AND is_del = 0
          AND type = 1
          AND file_id = #{fileId}
    </select>
</mapper>
