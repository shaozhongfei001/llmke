<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gientech.sensitivewordsservice.domain.mapper.SensitiveWordsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.gientech.sensitivewordsservice.domain.model.SensitiveWordsDO">
        <id column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="name" property="name"/>
        <result column="descript" property="descript"/>
        <result column="words" property="words" javaType="java.util.LinkedHashSet" jdbcType="LONGNVARCHAR"
                typeHandler="com.gientech.ragcommon.infrastructure.typehandler.LinkedHashSetTypeHandler"/>
        <result column="status" property="status"/>
    </resultMap>

    <resultMap id="BaseResultMapWithCount" type="com.gientech.sensitivewordsservice.domain.model.SensitiveWordsDO">
        <id column="id" property="id"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modified" property="gmtModified"/>
        <result column="name" property="name"/>
        <result column="descript" property="descript"/>
        <result column="words" property="words" javaType="java.util.LinkedHashSet" jdbcType="LONGNVARCHAR"
                typeHandler="com.gientech.ragcommon.infrastructure.typehandler.LinkedHashSetTypeHandler"/>
        <result column="status" property="status"/>
        <result column="count" property="count"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id
        , gmt_create, gmt_modified, name, descript, words, status
    </sql>

    <select id="queryWordsPageById" resultMap="BaseResultMapWithCount">
        SELECT id,
               gmt_create,
               gmt_modified,
               `name`,
               descript,
               CASE
                   WHEN IFNULL(words, '') = '' THEN words
                   ELSE SUBSTRING_INDEX(SUBSTRING_INDEX(words, ',', #{pageNo} * #{pageSize}), ',', -1 * #{pageSize})
                   END AS `words`,
               `status`,
               CASE
                   WHEN IFNULL(words, '') = '' THEN 0
                   ELSE LENGTH(IFNULL(words, '')) - LENGTH(REPLACE(IFNULL(words, ''), ',', '')) + 1
                   END AS `count`
        FROM sensitive_words
        WHERE id = #{id}
    </select>

    <select id="selectPageCustom" resultMap="BaseResultMapWithCount">
        SELECT id,
               gmt_create,
               gmt_modified,
               `name`,
               descript,
               CASE
                   WHEN IFNULL(words, '') = '' THEN 0
                   ELSE LENGTH(IFNULL(words, '')) - LENGTH(REPLACE(IFNULL(words, ''), ',', '')) + 1
                   END AS `count`,
               CASE
                   WHEN IFNULL(words, '') = '' THEN words
                   ELSE SUBSTRING_INDEX(words, ',', 30)
                   END AS `words`,
               `status`
        FROM sensitive_words ${ew.customSqlSegment}
    </select>
</mapper>
