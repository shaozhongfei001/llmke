node {  

  stage('SCM') {
    checkout scm
  }
  stage('SonarQube Analysis') {
    def scannerHome = tool 'SonarQube Scanner';
    withSonarQubeEnv() {
      sh """
        ${scannerHome}/bin/sonar-scanner \
        -Dsonar.projectKey=ail-rag-frontend-ai-plateform \
        -Dsonar.sources=. \
        -Dsonar.java.binaries=. \
        -Dsonar.branch.name=prod \
      """
    }
  }
}