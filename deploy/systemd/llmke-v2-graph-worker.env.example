# /etc/llmke/v2-graph-worker.env 示例。只放环境变量，不放命令行参数。
# MySQL 租约（--lease-backend mysql 时必需）
LLMKE_LEASE_MYSQL_HOST=127.0.0.1
LLMKE_LEASE_MYSQL_PORT=13306
LLMKE_LEASE_MYSQL_USER=llmke
LLMKE_LEASE_MYSQL_PASSWORD=__CHANGE_ME__
LLMKE_LEASE_MYSQL_DB=gienrag

# 注册中心（wait_ready.py nacos 用）
NACOS_SERVER_ADDRESS=127.0.0.1:18848
NACOS_DATA_ID=alg_doc_config_py

# MinerU / HF 离线（若同机跑解析）
MINERU_TOOLS_CONFIG_JSON=/var/lib/llmke/mineru/magic-pdf.json
HF_HUB_OFFLINE=1
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# 告警通道（可选）
# LLMKE_ALERT_WEBHOOK=https://example.invalid/hook
