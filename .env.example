# Example environment config — copy to .env (NEVER commit .env) and fill values.
# Placeholders only; real secrets must never enter git.

# Oracle (read-only metadata tooling) — all REQUIRED, no defaults provided.
ORACLE_HOST=<db-host>
ORACLE_PORT=1521
ORACLE_SERVICE=<service-name>
ORACLE_USER=<readonly-user>
ORACLE_PASSWORD=${ORACLE_PASSWORD}
# Optional: thick client library dir (leave empty for thin mode)
ORACLE_CLIENT_DIR=
# Optional: schema focus for metadata gates
ORACLE_METADATA_FOCUS_SCHEMA=<schema>

# Loop gate identity (P1-03): who is executing (dev vs independent QA)
SDD_IDENTITY=<your-agent-name>
SDD_IDENTITY_ROLE=dev
