          "minimum": 400,
          "maximum": 599
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "http_status",
        "message",
        "request_id",
        "retryable"
      ],
      "additionalProperties": false,
      "description": "错误码来自真实注册表；message 不含凭据、物理位置或未授权资产存在性。"
    }
