# R12 运行期环境变量模板（离线目标机）
# 用法：cp .env.template .env 后填写 CHANGE_ME 项；.env 不入包、不入库。
# 变量名必须与 docker/docker-compose.infra.yml 中的 ${...} 引用保持一致（目前仅下列 4 项）。
# 生成口令示例（离线同样可用）：openssl rand -base64 24

R12_MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
R12_REDIS_PASSWORD=CHANGE_ME_redis
R12_MINIO_ACCESS_KEY=r12minio
R12_MINIO_SECRET_KEY=CHANGE_ME_minio_secret

# 仅供 install-paths.sh / 自检脚本读取，不参与 compose 插值
R12_PREFIX=/opt/r12
R12_SRC_ROOT=/opt/r12/src
