EnvironmentFile=/home/szf/data/dev/llmke-r12/platform/r12/systemd/doc-parse.env
WorkingDirectory=/home/szf/data/dev/llmke-r12/services/rag-alg/alg_doc_parse_service
ExecStart=/home/szf/data/dev/llmke-r12/platform/r12/venvs/parse/bin/python -u alg_doc_parse_service_start.py
